rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // Game Configs (public read, authenticated write)
    match /game_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User Data (owner write)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default match for other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
